{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${modversion}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"${author}"
	],
	"contact": {
		"sources": "https://github.com/${github}"
	},
	"license": "${license}",
	"environment": "client",
	"entrypoints": {
		"client": [
			"coffee.axle.sessionauth.CoffeeAuth"
		]
	},
	"mixins": [
		"coffeeauth.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "${mc}",
		"java": ">=21",
		"fabric-api": "*"
	}
}
